/initial_experiments/**/cache/
/initial_experiments/**/tmp/
/initial_experiments/**/dependencies/
/initial_experiments/**/plot_deps/
/initial_experiments/**/.plotdeps/
/initial_experiments/**/checkpoints/
/initial_experiments/**/best/
/initial_experiments/**/verified_*/

# Round-five generated results and local executables; keep source and docs.
/initial_experiments/5/**/results/
