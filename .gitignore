# Local environments, caches, and agent session state.
.venv/
venv/
__pycache__/
*.py[cod]
.agent-home/
.pytest_cache/
*.prof

# Host-provided inputs and verifier installations.
/from_host/

# Generated experiment trees: ignore directories to avoid traversing GBs of data.
/initial_experiments/**/candidates/
/initial_experiments/**/cand/
/initial_experiments/**/parameters/
/initial_experiments/**/runs/
/initial_experiments/**/submission/
/initial_experiments/**/baseline/
